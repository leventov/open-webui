FROM node:22-alpine3.20 AS fe-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --force
COPY . .
RUN npm run build

FROM ghcr.io/open-webui/open-webui:main

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    procps \
    psmisc \
    iproute2 \
    net-tools \
    vim-tiny \
    less \
    curl \
 && rm -rf /var/lib/apt/lists/*

# Overlay local backend to ensure our server changes (e.g., x-bf-vk injection) are included
COPY backend/ /app/backend/

# Ensure required Python dependencies present in base image via uv only, and pin bcrypt to a passlib-compatible version
RUN uv pip install --system --no-cache-dir -r /app/backend/requirements.txt && \
    uv pip install --system --no-cache-dir 'passlib[bcrypt]==1.7.4' 'bcrypt==4.0.1'

# Overlay rebuilt frontend from local sources
COPY --from=fe-build /app/build /app/build

#### Removed runtime package install to reduce startup latency; dependencies are baked at build time

